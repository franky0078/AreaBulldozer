<Project>
  <PropertyGroup>
    <!-- Change only this value (major.minor.patch), then rebuild the project. -->
    <ModVersion>1.9.4</ModVersion>
    <Version>$(ModVersion)</Version>
    <AssemblyVersion>$(ModVersion).0</AssemblyVersion>
    <FileVersion>$(ModVersion).0</FileVersion>
    <InformationalVersion>$(ModVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
